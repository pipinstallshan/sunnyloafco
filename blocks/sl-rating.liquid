{%- doc -%}
  Star-rating slot, intended directly under the product title.
  Shows a review-app badge target (Judge.me compatible) once an app is installed.
  Can also show a manual rating from the product's "reviews" metafields as a fallback.
{%- enddoc -%}
{%- liquid
  assign bs = block.settings
  assign p = closest.product
  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value
-%}
<div class="sl-rating-slot spacing-style" style="{% render 'spacing-style', settings: bs %}" {{ block.shopify_attributes }}>
  {%- comment -%} Review-app badge target. Judge.me and most review apps populate this. {%- endcomment -%}
  <div class="jdgm-widget jdgm-preview-badge" data-id="{{ p.id }}"></div>

  {%- if bs.show_manual_fallback and rating != blank -%}
    {%- assign rounded = rating.rating | default: rating | round -%}
    <span class="sl-rating-slot__stars" aria-hidden="true">
      {%- for i in (1..5) -%}{% if i <= rounded %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
    </span>
    <span>
      {{ rating.rating | default: rating }}
      {%- if rating_count != blank %} ({{ rating_count }}){% endif -%}
    </span>
  {%- elsif request.design_mode -%}
    <span class="sl-rating-slot__stars" aria-hidden="true">&#9734;&#9734;&#9734;&#9734;&#9734;</span>
    <span style="opacity:.7">Review badge appears here once a review app (e.g. Judge.me) is installed.</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Star rating slot",
  "settings": [
    { "type": "paragraph", "content": "A slot for your review app's rating badge (Judge.me compatible). Add the review app's own block below for the full reviews widget." },
    { "type": "checkbox", "id": "show_manual_fallback", "label": "Show rating from \"reviews\" metafields if present", "default": true },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Star rating slot", "category": "Sunny Loaf" }]
}
{% endschema %}
