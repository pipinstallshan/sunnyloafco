{%- liquid
  assign s = section.settings
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container sl-404">
    {%- if s.show_icon -%}
      {% render 'sl-icon', name: 'cat', class: 'sl-404__icon' %}
    {%- endif -%}
    <p class="sl-404__code">404</p>
    {%- if s.heading != blank -%}<h1 class="sl-heading">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.text != blank -%}<p class="sl-subheading" style="margin-inline:auto;">{{ s.text }}</p>{%- endif -%}

    {%- if s.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="sl-404__search">
        <label class="sl-visually-hidden" for="Search404">Search</label>
        <input type="search" id="Search404" name="q" class="sl-input" placeholder="{{ s.search_placeholder }}" required>
        <button type="submit" class="button">{% render 'sl-icon', name: 'search' %}<span class="sl-visually-hidden">Search</span></button>
      </form>
    {%- endif -%}

    <div class="sl-buttons">
      <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
      <a class="button-secondary" href="{{ routes.root_url }}">{{ s.button_label_2 }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 content",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "checkbox", "id": "show_icon", "label": "Show cat icon", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page wandered off to find a sun patch." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The link may be wrong, or the page has moved. Let's get you back to the warm spots." },
    { "type": "checkbox", "id": "show_search", "label": "Show search box", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for perches, beds, toys…" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop everything" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Back home" }
  ]
}
{% endschema %}
