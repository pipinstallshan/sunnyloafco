{%- liquid
  assign s = section.settings
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container">
    <div class="sl-about__grid">
      <div class="sl-about__media">
        <div class="sl-about__mark">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: shop.name | escape }}
          {%- else -%}
            <img src="{{ 'lockup-stacked-tagline.png' | asset_url }}" width="520" height="419" alt="{{ shop.name | escape }}" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="sl-about__content">
        {%- if s.eyebrow != blank -%}<p class="sl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="sl-heading">{{ s.heading }}</h1>{%- endif -%}

        <dl class="sl-about__definition">
          <dt>{{ s.term }} <span>{{ s.pronunciation }}</span></dt>
          <dd>{{ s.definition }}</dd>
        </dl>

        {%- if s.body != blank -%}
          <div class="sl-about__body sl-rte rte">{{ s.body }}</div>
        {%- endif -%}

        {%- if s.button_label != blank -%}
          <div class="sl-buttons">
            <a class="button" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About / what is a loaf",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the stacked Sunny Loaf lockup." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A sunny little home brand for cats" },
    { "type": "text", "id": "term", "label": "Definition term", "default": "loaf" },
    { "type": "text", "id": "pronunciation", "label": "Pronunciation / part of speech", "default": "noun, cat slang" },
    { "type": "textarea", "id": "definition", "label": "Definition", "default": "A cat sitting tucked up with its paws hidden under its chest, like it plans to stay until the sun moves. That is the whole warmth of our name." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Sunny Loaf Co. makes thoughtfully chosen home essentials for American cat owners: window perches, beds, and everyday pieces for cats who loaf in the sun. We pick a few things worth bringing into a real home, photograph them honestly, and ship them from the US with tracking.</p><p>No bakery here, just cats, sunny windows, and the people who arrange the furniture around them.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "About / what is a loaf", "category": "Sunny Loaf" }]
}
{% endschema %}
