{%- liquid
  assign s = section.settings
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container">
    <div class="sl-signup{% if s.boxed %} sl-signup--boxed{% endif %}">
      <div class="sl-signup__inner">
        <div class="sl-signup__copy">
          {%- if s.eyebrow != blank -%}<p class="sl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="sl-heading">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.subhead != blank -%}<p class="sl-subheading">{{ s.subhead }}</p>{%- endif -%}
        </div>
        <div class="sl-signup__form">
          {%- form 'customer' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, sunny-side">
            {%- if form.posted_successfully? -%}
              <p class="sl-form-message">{{ s.success_text }}</p>
            {%- else -%}
              <div class="sl-signup__form-row">
                <label class="sl-visually-hidden" for="SlEmail-{{ section.id }}">Email</label>
                <input
                  id="SlEmail-{{ section.id }}"
                  class="sl-input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="{{ s.placeholder }}"
                  required
                >
                <button type="submit" class="button">{{ s.button_label }}</button>
              </div>
              {%- if form.errors -%}
                <p class="sl-form-message sl-form-message--error">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
          {%- if s.fineprint != blank -%}<p class="sl-signup__fineprint">{{ s.fineprint }}</p>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "dark"
    },
    { "type": "checkbox", "id": "boxed", "label": "Show as a boxed card", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the sunny side" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes from the sunny window" },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Supporting text",
      "default": "The occasional email: new arrivals, sunny-spot tips, and the odd very good loaf. No spam, unsubscribe anytime."
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "you@example.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Keep me posted" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're on the list. See you on the sunny side ☀️" },
    { "type": "text", "id": "fineprint", "label": "Fine print", "default": "By subscribing you agree to receive marketing emails from Sunny Loaf Co." }
  ],
  "presets": [{ "name": "Email signup", "category": "Sunny Loaf" }]
}
{% endschema %}
