{%- liquid
  assign s = section.settings
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container">
    <div class="sl-faq__layout">
      <div class="sl-faq__intro">
        {%- if s.eyebrow != blank -%}<p class="sl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sl-heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subhead != blank -%}<p class="sl-subheading">{{ s.subhead }}</p>{%- endif -%}
      </div>
      <div class="sl-faq__list">
        {%- for block in section.blocks -%}
          <details class="sl-faq__item" name="sl-faq-{{ section.id }}"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question }}</span>
              <span class="sl-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="sl-faq__answer sl-rte rte">{{ block.settings.answer }}</div>
          </details>
        {%- else -%}
          <div class="sl-editor-note">Add questions in the theme editor.</div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Supporting text",
      "default": "Shipping, returns, sizing and cat safety. Edit any of these to match your real policies."
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders ship from the US. Please allow 1&ndash;3 business days to process, then typically 5&ndash;10 business days for delivery. You'll get tracking by email when it leaves the warehouse. Edit this to match your real times.</p>"
        },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "category": "Sunny Loaf",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship from the US. Please allow 1&ndash;3 business days to process, then typically 5&ndash;10 business days for delivery. You'll get tracking by email when it leaves the warehouse. Edit this to match your real times.</p>",
            "open": true
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What's your return policy?",
            "answer": "<p>Returns are accepted within 30 days of delivery, in the condition you received it. If anything arrives damaged or wrong, email hello@sunnyloafco.com and we'll make it right. Edit this to match your real policy.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Will this fit my windowsill and my cat?",
            "answer": "<p>Every product page lists Width, Height, Length, Weight capacity and Material. Measure your sill and check your cat's weight against the capacity before ordering. Not sure? Email us the measurements and we'll help.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Is it safe for my cat?",
            "answer": "<p>We choose sturdy, stable pieces and list materials honestly. Always follow the setup instructions, check weight limits, and supervise the first few uses. Edit this with any product-specific safety notes.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
