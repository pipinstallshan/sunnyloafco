{%- liquid
  assign s = section.settings
  assign on_media = false
  if s.image != blank or s.mobile_image != blank or s.video != blank
    assign on_media = true
  endif

  assign v_align = 'center'
  if s.vertical_alignment == 'top'
    assign v_align = 'flex-start'
  elsif s.vertical_alignment == 'bottom'
    assign v_align = 'flex-end'
  endif

  assign h_align = 'flex-start'
  assign text_align = 'left'
  if s.content_alignment == 'center'
    assign h_align = 'center'
    assign text_align = 'center'
  elsif s.content_alignment == 'right'
    assign h_align = 'flex-end'
    assign text_align = 'right'
  endif
-%}
<section
  class="sl-hero sl-scheme--{{ s.color_scheme }}{% if on_media %} sl-hero--on-media{% endif %}"
  style="
    --sl-hero-height: {{ s.height_desktop }}vh;
    --sl-hero-height-mobile: {{ s.height_mobile }}svh;
    --sl-v-align: {{ v_align }};
    --sl-v-align-mobile: {{ v_align }};
    --sl-h-align: {{ h_align }};
    --sl-text-align: {{ text_align }};
    --sl-focal: {{ s.focal_x }}% {{ s.focal_y }}%;
    --sl-focal-mobile: {{ s.focal_x_mobile }}% {{ s.focal_y_mobile }}%;
    --sl-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
  "
  {{ section.shopify_attributes }}
>
  {%- if on_media -%}
    <div class="sl-hero__media{% if s.mobile_image != blank %} sl-hero__media--has-mobile{% endif %}">
      {%- if s.video != blank -%}
        {{
          s.video
          | video_tag: image_size: '1600x', loop: true, autoplay: true, muted: true, controls: false, playsinline: true
        }}
      {%- else -%}
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 2400
            | image_tag:
              class: 'sl-hero__img--desktop',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '750, 1100, 1500, 1800, 2400',
              alt: s.image.alt | default: shop.name
          }}
        {%- else -%}
          <img
            class="sl-hero__img--desktop"
            src="{{ 'shopify-hero-2400x900.png' | asset_url }}"
            width="2400"
            height="900"
            alt="{{ shop.name | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
        {%- if s.mobile_image != blank -%}
          {{
            s.mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'sl-hero__img--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '600, 900, 1200',
              alt: s.mobile_image.alt | default: shop.name
          }}
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if s.overlay_opacity > 0 -%}
      <div class="sl-hero__overlay"></div>
    {%- endif -%}
  {%- endif -%}

  <div class="sl-hero__inner sl-container">
    <div class="sl-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="sl-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="sl-heading sl-hero__heading">{{ s.heading }}</h1>
      {%- endif -%}
      {%- if s.tagline != blank -%}
        <p class="sl-subheading sl-hero__tagline">{{ s.tagline }}</p>
      {%- endif -%}
      {%- if s.subhead != blank -%}
        <p class="sl-subheading">{{ s.subhead }}</p>
      {%- endif -%}
      {%- if s.button_label != blank or s.button_label_2 != blank -%}
        <div class="sl-buttons">
          {%- if s.button_label != blank -%}
            <a
              class="button"
              href="{{ s.button_link | default: '#' }}"
            >
              {{- s.button_label -}}
            </a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            <a
              class="button-secondary"
              href="{{ s.button_link_2 | default: '#' }}"
            >
              {{- s.button_label_2 -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sunny hero",
  "tag": "section",
  "class": "sl-section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Used when no background media is set, and behind any overlay.",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "dark"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sunny home goods for cats" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A warmer spot for the cat who loafs" },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Made for cats who loaf in the sun."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Supporting text",
      "default": "Window perches, beds, and sunny-home essentials, chosen with care and shipped from the US."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Background media" },
    {
      "type": "paragraph",
      "content": "Leave image and video empty to use the default hero placeholder until you add real lifestyle photos."
    },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. Falls back to the desktop image." },
    { "type": "video", "id": "video", "label": "Background video", "info": "Overrides the image when set. Plays muted and looped." },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    { "type": "header", "content": "Focal point (desktop)" },
    { "type": "range", "id": "focal_x", "label": "Horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Focal point (mobile)" },
    { "type": "range", "id": "focal_x_mobile", "label": "Horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y_mobile", "label": "Vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Height" },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 40, "max": 100, "step": 2, "unit": "vh", "default": 72 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 80 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    }
  ],
  "presets": [{ "name": "Sunny hero", "category": "Sunny Loaf" }]
}
{% endschema %}
