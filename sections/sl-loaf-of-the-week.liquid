{%- liquid
  assign s = section.settings
  assign product = s.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'LoafOfWeek-' | append: section.id
  assign submit_id = form_id | append: '-submit'
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container">
    <div class="sl-lotw__grid{% if s.image_position == 'right' %} sl-lotw--image-right{% endif %}">
      <div class="sl-lotw__media">
        <span class="sl-lotw__glow" aria-hidden="true"></span>
        <div class="sl-lotw__frame">
          {%- if s.badge_text != blank -%}
            <span class="sl-lotw__badge">{% render 'sl-icon', name: 'sun' %}{{ s.badge_text }}</span>
          {%- endif -%}
          {%- if product.featured_media != blank -%}
            {{
              product.featured_media
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 55vw, 100vw',
                widths: '500, 700, 900, 1200',
                alt: product.featured_media.alt | default: product.title | escape
            }}
          {%- else -%}
            <div class="sl-lotw__placeholder">
              {% render 'sl-icon', name: 'cat' %}
              <span>Your featured loaf</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="sl-lotw__content">
        {%- if s.eyebrow != blank -%}<p class="sl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if product != blank -%}
          <h2 class="sl-lotw__title"><a href="{{ product.url }}">{{ product.title }}</a></h2>
          {%- liquid
            assign blurb = s.blurb
            if blurb == blank
              assign blurb = product.description | strip_html | truncatewords: 40
            endif
          -%}
          {%- if blurb != blank -%}<p class="sl-lotw__blurb">{{ blurb }}</p>{%- endif -%}

          {%- liquid
            assign has_feat = false
            if s.feature_1 != blank or s.feature_2 != blank or s.feature_3 != blank
              assign has_feat = true
            endif
          -%}
          {%- if has_feat -%}
            <ul class="sl-lotw__features" role="list">
              {%- if s.feature_1 != blank -%}<li>{% render 'sl-icon', name: 'paw' %}<span>{{ s.feature_1 }}</span></li>{%- endif -%}
              {%- if s.feature_2 != blank -%}<li>{% render 'sl-icon', name: 'paw' %}<span>{{ s.feature_2 }}</span></li>{%- endif -%}
              {%- if s.feature_3 != blank -%}<li>{% render 'sl-icon', name: 'paw' %}<span>{{ s.feature_3 }}</span></li>{%- endif -%}
            </ul>
          {%- endif -%}

          <p class="sl-lotw__price">
            {%- if variant.compare_at_price > variant.price -%}
              <span class="sl-lotw__price-now">{{ variant.price | money }}</span>
              <s>{{ variant.compare_at_price | money }}</s>
              {%- assign saved = variant.compare_at_price | minus: variant.price -%}
              <span class="sl-lotw__save">Save {{ saved | money }}</span>
            {%- else -%}
              <span class="sl-lotw__price-now">{{ variant.price | money }}</span>
            {%- endif -%}
          </p>

          <div class="sl-lotw__buy">
            <product-form-component
              data-section-id="{{ section.id }}"
              data-product-id="{{ product.id }}"
            >
              {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ variant.id }}"
                  ref="variantId"
                >
                {% render 'add-to-cart-button',
                  id: submit_id,
                  class: 'button',
                  can_add_to_cart: variant.available,
                  show_icon: variant.available,
                  product: product,
                  add_to_cart_text: s.button_label
                %}
              {%- endform -%}
            </product-form-component>
          </div>

          {%- if s.show_link -%}
            <a class="sl-lotw__link" href="{{ product.url }}">{{ s.link_text }} &rarr;</a>
          {%- endif -%}

          {%- if s.reassurance != blank -%}
            <p class="sl-lotw__reassure">{% render 'sl-icon', name: 'shipping' %}<span>{{ s.reassurance }}</span></p>
          {%- endif -%}
        {%- else -%}
          <div class="sl-editor-note">Pick a product in the theme editor to feature it here.</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if product != blank -%}
  <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "Loaf of the week",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "accent"
    },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loaf of the week" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Loaf of the week" },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "info": "Leave empty to use the start of the product description.",
      "default": "The one we keep coming back to. A warm, sturdy spot that looks like it was always meant to live by your window."
    },
    { "type": "header", "content": "Feature list", "info": "Up to three short selling points. Leave a line empty to hide it." },
    { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Sized for real windowsills" },
    { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Holds the biggest loafs with room to stretch" },
    { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Warm, washable, and built to last" },
    { "type": "header", "content": "Buy" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_link", "label": "Show \"view details\" link", "default": true },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See the full details" },
    { "type": "text", "id": "reassurance", "label": "Reassurance line", "default": "Free US shipping over $49 · Easy 30-day returns" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [{ "name": "Loaf of the week", "category": "Sunny Loaf" }]
}
{% endschema %}
