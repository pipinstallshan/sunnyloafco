{%- liquid
  assign s = section.settings
-%}
<div class="sl-password sl-scheme--{{ s.color_scheme }}" style="--sl-logo-width: {{ s.logo_width }}px;">
  <span class="sl-password__sun" aria-hidden="true"></span>
  <div class="sl-password__inner">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 600 | image_tag: class: 'sl-password__logo', loading: 'eager', alt: shop.name | escape }}
    {%- else -%}
      <img
        class="sl-password__logo"
        src="{{ 'lockup-stacked-tagline.png' | asset_url }}"
        width="520"
        height="419"
        alt="{{ shop.name | escape }}"
        loading="eager"
      >
    {%- endif -%}

    {%- if s.heading != blank -%}<h1 class="sl-password__heading">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.tagline != blank -%}<p class="sl-password__tagline">{{ s.tagline }}</p>{%- endif -%}
    {%- if s.text != blank -%}<p class="sl-password__text">{{ s.text }}</p>{%- endif -%}

    <div class="sl-password__form">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, opening-soon">
        {%- if form.posted_successfully? -%}
          <p class="sl-form-message">{{ s.success_text }}</p>
        {%- else -%}
          <div class="sl-signup__form-row">
            <label class="sl-visually-hidden" for="PwEmail">Email</label>
            <input id="PwEmail" class="sl-input" type="email" name="contact[email]" placeholder="{{ s.placeholder }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
            <button type="submit" class="button">{{ s.button_label }}</button>
          </div>
          {%- if form.errors -%}
            <p class="sl-form-message sl-form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if s.instagram_url != blank -%}
      <a class="sl-password__social" href="{{ s.instagram_url }}" target="_blank" rel="noopener">
        {% render 'sl-icon', name: 'instagram' %}
        <span>{{ s.instagram_label }}</span>
      </a>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <div class="sl-password__text rte">{{ shop.password_message }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Opening soon",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the stacked Sunny Loaf lockup." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 160, "max": 420, "step": 10, "unit": "px", "default": 260 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon ☀️" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Made for cats who loaf in the sun." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're warming up the windowsills. Drop your email and we'll let you know the moment the shop is open." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "you@example.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you! We'll be in touch when we open ☀️" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link", "default": "https://instagram.com/sunnyloafco" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "Follow @sunnyloafco" }
  ]
}
{% endschema %}
