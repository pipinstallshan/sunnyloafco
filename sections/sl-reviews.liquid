{%- doc -%}
  Product reviews section (Judge.me compatible).
  Renders the Judge.me review-widget target. It stays empty until the Judge.me
  app is installed and its app embed is enabled; then it fills with the review
  list and "write a review" form. See README / Judge.me for setup.
{%- enddoc -%}
{%- liquid
  assign s = section.settings
-%}
<section
  class="sl-section sl-scheme--{{ s.color_scheme }} sl-reviews"
  style="--sl-pad-top: {{ s.padding_top }}px; --sl-pad-bottom: {{ s.padding_bottom }}px;"
  {{ section.shopify_attributes }}
>
  <div class="sl-container">
    {%- if s.eyebrow != blank -%}<p class="sl-eyebrow sl-reviews__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="sl-heading sl-reviews__heading">{{ s.heading }}</h2>{%- endif -%}

    {%- if product != blank -%}
      <div
        class="jdgm-widget jdgm-review-widget"
        data-id="{{ product.id }}"
        data-product-title="{{ product.title | escape }}"
      ></div>
    {%- else -%}
      <div class="sl-editor-note">
        Customer reviews appear here on product pages once the Judge.me app is installed and its app embed is enabled.
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the Judge.me review widget on product pages. Install the Judge.me app and enable its app embed (Theme settings → App embeds) for reviews to appear."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by cats & their humans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Product reviews", "category": "Sunny Loaf" }]
}
{% endschema %}
