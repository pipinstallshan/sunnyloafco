{%- liquid
  assign s = section.settings
  assign quotes = section.blocks | where: 'type', 'quote'
  assign photos = section.blocks | where: 'type', 'photo'
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="sl-container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="sl-section-head sl-section-head--center">
        {%- if s.eyebrow != blank -%}<p class="sl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sl-heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subhead != blank -%}<p class="sl-subheading">{{ s.subhead }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if quotes.size > 0 -%}
      <div class="sl-testimonials__grid">
        {%- for block in quotes -%}
          <figure class="sl-quote sl-card sl-card--shadow" {{ block.shopify_attributes }}>
            {%- if block.settings.is_placeholder -%}
              <span class="sl-placeholder-note">Placeholder &middot; edit or remove</span>
            {%- endif -%}
            {%- if block.settings.rating > 0 -%}
              <div class="sl-quote__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}{% if i <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="sl-quote__text">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            <figcaption class="sl-quote__author">
              {%- if block.settings.avatar != blank -%}
                {%- assign avatar_alt = block.settings.author | escape -%}
                {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: avatar_alt }}
              {%- endif -%}
              <span>{{ block.settings.author }}{% if block.settings.location != blank %} &middot; {{ block.settings.location }}{% endif %}</span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.ugc_enabled -%}
      <div class="sl-ugc">
        <div class="sl-ugc__head">
          <h3>{{ s.ugc_heading }}</h3>
          {%- if s.ugc_link != blank -%}
            <a class="sl-lotw__link" href="{{ s.ugc_link }}">{{ s.ugc_link_text }} &rarr;</a>
          {%- endif -%}
        </div>
        <div class="sl-ugc__grid">
          {%- if photos.size > 0 -%}
            {%- for block in photos -%}
              {%- if block.settings.link != blank -%}
                <a class="sl-ugc__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 16vw, 33vw', widths: '200,300,400', alt: block.settings.alt | escape }}
                  {%- else -%}
                    {% render 'sl-icon', name: 'cat' %}
                  {%- endif -%}
                </a>
              {%- else -%}
                <span class="sl-ugc__tile" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 16vw, 33vw', widths: '200,300,400', alt: block.settings.alt | escape }}
                  {%- else -%}
                    {% render 'sl-icon', name: 'cat' %}
                  {%- endif -%}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <span class="sl-ugc__tile sl-ugc__tile--empty">{% render 'sl-icon', name: 'paw' %}</span>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if photos.size == 0 -%}
          <p class="sl-signup__fineprint">Placeholder tiles. Add real Instagram photos as "UGC photo" blocks when you have them.</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials & UGC",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Testimonials below are placeholders. Replace them with real customer words before launch — never post invented reviews."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the sunny side" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by cats, chosen by cat people" },
    { "type": "textarea", "id": "subhead", "label": "Supporting text" },
    { "type": "header", "content": "Instagram / UGC grid" },
    { "type": "checkbox", "id": "ugc_enabled", "label": "Show photo grid", "default": true },
    { "type": "text", "id": "ugc_heading", "label": "Grid heading", "default": "Tag @sunnyloafco to be featured" },
    { "type": "url", "id": "ugc_link", "label": "Grid link" },
    { "type": "text", "id": "ugc_link_text", "label": "Grid link text", "default": "Follow on Instagram" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "checkbox", "id": "is_placeholder", "label": "Mark as placeholder", "info": "Shows a reminder label in the editor only... remove once this is a real review.", "default": true },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "She found the sunny perch within an hour and has barely left it since." },
        { "type": "text", "id": "author", "label": "Author", "default": "Placeholder name" },
        { "type": "text", "id": "location", "label": "Location", "default": "City, ST" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    },
    {
      "type": "photo",
      "name": "UGC photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "A cat loafing in the sun" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials & UGC",
      "category": "Sunny Loaf",
      "blocks": [
        { "type": "quote", "settings": { "quote": "She found the sunny perch within an hour and has barely left it since.", "author": "Placeholder name", "location": "Portland, OR" } },
        { "type": "quote", "settings": { "quote": "Sturdier than it looks and it actually fits our narrow sill. The cat approves.", "author": "Placeholder name", "location": "Austin, TX" } },
        { "type": "quote", "settings": { "quote": "Shipped quickly and looks right at home in the living room. A proper loafing spot.", "author": "Placeholder name", "location": "Columbus, OH" } }
      ]
    }
  ]
}
{% endschema %}
