{%- liquid
  assign s = section.settings
  assign columns = section.blocks.size
  if columns > 4
    assign columns = 4
  endif
  if columns < 1
    assign columns = 1
  endif
-%}
<section class="sl-section sl-scheme--{{ s.color_scheme }}" style="--sl-pad-top: {{ s.padding_top }}px; --sl-pad-bottom: {{ s.padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="sl-container">
    {%- if s.heading != blank -%}
      <div class="sl-section-head sl-section-head--center">
        <h2 class="sl-heading">{{ s.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="sl-trust__list sl-trust--compact" style="--sl-columns: {{ columns }};">
      {%- for block in section.blocks -%}
        <li class="sl-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {% render 'sl-icon', name: block.settings.icon %}
          {%- endif -%}
          <div>
            {%- if block.settings.title != blank -%}<p class="sl-trust__title">{{ block.settings.title }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="sl-trust__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- else -%}
        <li class="sl-editor-note">Add trust items in the theme editor.</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust & shipping strip",
  "tag": "section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light (Warm Milk)" },
        { "value": "accent", "label": "Accent (Wheatfield)" },
        { "value": "dark", "label": "Dark (Charcoal)" }
      ],
      "default": "accent"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "support", "label": "Support" },
            { "value": "sun", "label": "Sun" },
            { "value": "paw", "label": "Paw" },
            { "value": "none", "label": "None" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Fast US shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tracked delivery on every order." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust & shipping strip",
      "category": "Sunny Loaf",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "title": "Fast US shipping", "text": "Tracked delivery on every order." } },
        { "type": "item", "settings": { "icon": "returns", "title": "30-day returns", "text": "Changed your mind? Send it back." } },
        { "type": "item", "settings": { "icon": "secure", "title": "Secure checkout", "text": "Encrypted, trusted payment." } },
        { "type": "item", "settings": { "icon": "support", "title": "Friendly support", "text": "Real replies within one business day." } }
      ]
    }
  ]
}
{% endschema %}
